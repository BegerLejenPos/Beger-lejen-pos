
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['main', 'worker'];
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /sales/{saleId} {
      allow read: if validRole();

      allow create: if validRole()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'completed'
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.cashReceived is number
        && request.resource.data.change is number
        && request.resource.data.items is list;

      allow update, delete: if validRole()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'main';
    }
  }
}
